{
  "name": "dsh-cpa-search-provider",
  "version": "0.1.0",
  "description": "CPA Responses web search and fetch provider for DeepSeek Harness, with zero runtime dependencies",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-bundle",
    "deepseek-harness",
    "cpa",
    "web-search",
    "cordis"
  ],
  "icon": "./icon.svg",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE",
    "locale/*.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/douglarek/dsh-cpa-search-provider.git"
  }
}
